# Application
APP_NAME=Marine WhatsApp Chatbot
APP_ENV=development
APP_REVISION=local
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=

# Marine tenant identity
TENANT_CODE=marine
ACTIVE_LOCATION=
ACTIVE_PRODUCT=

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Exotel — use only Marine account and sender credentials
EXOTEL_ACCOUNT_SID=echt61
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_API_BASE_URL=https://api.exotel.com
EXOTEL_WHATSAPP_FROM=+917948502803
EXOTEL_STATUS_CALLBACK_URL=
EXOTEL_OUTBOUND_ENABLED=false
EXOTEL_SIGNATURE_VALIDATION_ENABLED=false

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_EMBEDDING_DIMENSIONS=
MARINE_KNOWLEDGE_BASE_PATH=documents/active/ECHT_MARINE_KNOWLEDGE_BASE_V2.md
MARINE_PRODUCT_CATALOG_PATH=documents/active/ECHT_MARINE_PRODUCT_CATALOG.md
MARINE_KNOWLEDGE_MAX_SECTIONS=4
# Optional model used for structured extraction and grounded answers.
# The chatbot retains a conservative local extraction fallback if it is unset.

# Runtime controls
CHATBOT_ENABLED=false
INTERACTIVE_WHATSAPP_ENABLED=false
CONVERSATION_SESSION_TTL_MINUTES=30
APP_TIMEZONE=Asia/Kolkata

# Zoho CRM — keep OAuth credentials only in the uncommitted .env
ZOHO_CRM_ENABLED=false
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.in
ZOHO_API_BASE_URL=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_LEADS_MODULE=Leads
